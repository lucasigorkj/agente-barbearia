# ---------------------------------------------------------------------------
# Obrigatoria
# ---------------------------------------------------------------------------

# https://aistudio.google.com/apikey
GEMINI_API_KEY=

# ---------------------------------------------------------------------------
# Identidade do negocio -- e so isto que muda de um cliente para outro
# ---------------------------------------------------------------------------

EMPRESA_NOME=
EMPRESA_CIDADE=
ATENDENTE_NOME=

# Endereco e horario sao OPCIONAIS de proposito.
# Vazio e melhor que errado: sem eles o agente agenda por periodo e deixa a
# confirmacao exata com a equipe. Preenchido errado, ele manda o cliente na
# porta fechada.
EMPRESA_ENDERECO=
EMPRESA_HORARIO=

# O servidor da nuvem roda em UTC. Sem isto o agente erra o dia da semana.
TIMEZONE=America/Sao_Paulo

# ---------------------------------------------------------------------------
# WhatsApp (UAZAPI) -- nao precisa para `npm run repl`
# ---------------------------------------------------------------------------

UAZAPI_URL=
UAZAPI_TOKEN=
# Filtro opcional, so util quando um webhook GLOBAL aponta varias instancias
# para o mesmo endpoint. Vazio = aceita qualquer uma.
UAZAPI_INSTANCE=

# Protege o webhook. Gere um valor aleatorio (ex: `openssl rand -hex 24`) e
# cadastre na UAZAPI a URL https://SEU-DOMINIO/webhook?secret=ESSE_VALOR
# Vazio = qualquer um que descubra a URL faz o agente responder por voce.
WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# Entrega do lead -- os dois sao opcionais e independentes
# ---------------------------------------------------------------------------

# WhatsApp de quem recebe o lead pronto. Ex: 5513999998888
HUMANO_WHATSAPP=
# POST do lead em JSON: n8n, Make, Zapier, Trello ou o CRM que o cliente ja usa.
LEAD_WEBHOOK_URL=

# ATENCAO: com os dois vazios, o lead qualificado existe SOMENTE no log do
# servidor. Deploy novo, log rotacionado, lead perdido. Para demo serve; para
# alguem que depende disso para vender, nao.

# ---------------------------------------------------------------------------
# Comportamento (tem default para tudo -- so mexa se precisar)
# ---------------------------------------------------------------------------

GEMINI_MODEL=gemini-3.5-flash-lite
TEMPERATURA=0.7
MAX_OUTPUT_TOKENS=400

# Janela de agrupamento de mensagens picadas, em ms.
DEBOUNCE_MS=6000

# Handoff: por quanto tempo o agente cala.
PAUSAR_APOS_LEAD=true
PAUSA_APOS_LEAD_MIN=120
PAUSA_HUMANO_MIN=60

# Humanizacao do envio: lida + "digitando..." + espera.
HUMANIZAR=true
DIGITANDO_BASE_MS=800
DIGITANDO_POR_CHAR_MS=25
DIGITANDO_MAX_MS=5000

# Memoria por conversa.
SESSAO_TTL_MS=7200000
MAX_HISTORICO=24
MAX_TOOL_ITERACOES=5

PORT=3000
